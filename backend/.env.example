# ─────────────────────────────────────────────────────────────────────────────
# Backend (FastAPI) environment — copy to backend/.env and fill in.
# Loaded by api.py via load_dotenv(); scripts read backend/.env explicitly.
# This file is a template; backend/.env is gitignored (root .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# --- GCP project (REQUIRED) -------------------------------------------------
# Startup raises if neither GCP_PROJECT_ID nor GCP_PROJECT is set.
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Google credentials: prefer Application Default Credentials.
#   local:  gcloud auth application-default login
#   or point at a service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json

# --- Vertex AI Search (Discovery Engine) — grounding sink --------------------
GCP_VERTEX_SEARCH_APP_ID=imm-postings-search-app
GCP_VERTEX_DATASTORE_ID=imm-postings-datastore
GCP_VERTEX_DATASTORE_LOCATION=global
# Tier-3 public reference engine (optional; leave blank until it finishes indexing)
GCP_VERTEX_PUBLIC_ENGINE_ID=
# Set to 1 to enable boostSpec precedence (app > reddit > public)
VERTEX_SEARCH_BOOST=0

# --- GCS bucket (sidecar ingestion) -----------------------------------------
GCP_BUCKET_NAME=imm-postings-ingestion

# --- Gemini models ----------------------------------------------------------
GCP_GEMINI_MODEL=gemini-2.5-flash
GCP_GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite
# AI-Assist router model (backend/assist.py). Dedicated so it can move to a newer
# Flash independently of tagging/moderation/profile. Flip to gemini-3-flash once
# it is GA in your Vertex project/region (as of 2026-09 only 2.5-flash is here).
GCP_GEMINI_ASSIST_MODEL=gemini-2.5-flash
GCP_GEMINI_LOCATION=us-central1

# --- App provenance identity (D-055) ----------------------------------------
# Set these to your domain once registered (config flip, no code change).
APP_SOURCE_SYSTEM=unclesamcalling
APP_BASE_URL=https://proceedings.app
POSTING_PIPELINE_RUN_ID=web-composer

# --- Dev-mode auth ----------------------------------------------------------
# 1 = allow unverified X-User-Id impersonation (dev/test ONLY). The code
# default is 0 (fail-closed) — prod never sets this; local dev opts in here.
ALLOW_USER_IMPERSONATION=1

# --- UGC moderation (App Store Guideline 1.2) -------------------------------
# Transactional email (report/block alerts + email verification) via Resend.
RESEND_API_KEY=
# Where report/block alerts are sent (defaults to support@meridianjourney.ai).
MODERATION_ALERT_EMAIL=
# Distinct reporters that auto-hide content pending 24h human review.
MODERATION_AUTO_TAKEDOWN_REPORTS=3
# Shared secret gating POST /api/admin/takedown (unset => endpoint always 403).
MODERATION_ADMIN_TOKEN=
# Set to 1 to skip the Gemini safety pass (wordlist-only content filtering).
MODERATION_DISABLE_LLM=0

# --- Optional: ingestion / labeling scripts ---------------------------------
# FIRECRAWL_API_KEY=
# LABEL_STUDIO_URL=
# LABEL_STUDIO_API_KEY=
